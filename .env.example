APP_NAME=Flinker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL do frontend (flinker_app) — usado pra montar o link do e-mail de redefinição
# de senha e como origem padrão do CORS_ALLOWED_ORIGINS abaixo.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flinker
DB_USERNAME=postgres
DB_PASSWORD=

# Domínio autorizado a usar cookies do Sanctum (SPAs). Ajuste para o domínio do painel React em produção.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Margem padrão da plataforma sobre o valor líquido informado pela empresa (regra de precificação, Fase 2)
PLATFORM_DEFAULT_MARGIN_PERCENT=7

# Gateway de pagamento ativo (ver App\Providers\PaymentGatewayServiceProvider).
# Hoje só "mercadopago" existe — trocar de gateway é criar uma nova implementação
# de PaymentGatewayInterface e mudar esse valor, sem tocar em Actions/Controllers.
PAYMENT_GATEWAY_DRIVER=mercadopago

# Mercado Pago (Fase 4 — Carteira e Pagamento). Gere credenciais de teste em
# https://www.mercadopago.com.br/developers — sem isso, depósitos não funcionam.
MERCADOPAGO_ACCESS_TOKEN=
# Chave de assinatura da notificação webhook (painel do Mercado Pago > Webhooks).
# Sem isso, a assinatura da notificação não é verificada (só a reconsulta da API).
MERCADOPAGO_WEBHOOK_SECRET=
# Precisa ser uma URL publicamente acessível (não funciona com localhost — use ngrok em dev)
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_RETURN_URL=

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por vírgula.
# Ajuste para o(s) domínio(s) reais do frontend antes de abrir pro teste.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Prazo (em horas) após o check-in pra completar automaticamente um Flink e liberar
# o pagamento ao profissional, caso a empresa já não tenha confirmado antes.
FLINKER_AUTO_COMPLETE_HOURS=48

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
